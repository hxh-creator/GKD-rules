{
  "name": "@hxh-creator/gkd-rules",
  "version": "0.0.0",
  "type": "module",
  "description": "GKD 订阅规则",
  "author": "hxh-creator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxh-creator/GKD-rules.git"
  },
  "bugs": {
    "url": "https://github.com/hxh-creator/GKD-rules/issues"
  },
  "homepage": "https://github.com/hxh-creator/GKD-rules#readme",
  "gkd": {
    "outDir": "dist",
    "file": "hxh-creator_gkd.json5",
    "versionFile": "hxh-creator_gkd.version.json5",
    "changelog": "CHANGELOG.md"
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "prettier --cache --write ./**/*.{js,cjs,mjs,ts,jsx,tsx,json}",
    "lint": "eslint --cache --fix ./**/*.{js,cjs,mjs,ts,jsx,tsx}",
    "check": "tsc --noEmit && tsx ./scripts/check.ts",
    "build": "tsc --noEmit && tsx ./scripts/build.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --config commitlint.config.ts --edit ${1}",
    "pre-push": "pnpm run check"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,jsx,tsx}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ],
    "*.json": [
      "prettier --cache --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "./dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@gkd-kit/api": "0.9.3",
    "@gkd-kit/define": "0.0.1",
    "@gkd-kit/tools": "0.8.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "json5": "2.2.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  },
  "volta": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.22.1"
  }
}
